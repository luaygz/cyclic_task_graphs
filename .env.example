# Model providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional cumulative spend caps (USD), enforced before every model call
CTG_SPEND_CAP_OPENAI_USD=
CTG_SPEND_CAP_OPENROUTER_USD=

# TextCraft recipe directory (run `ctg data fetch textcraft` first); defaults to ~/.cache/ctg/textcraft/recipes
TEXTCRAFT_RECIPES=

# ALFWorld data directory (run `alfworld-download` first); defaults to ~/.cache/alfworld
ALFWORLD_DATA=

# Finance-Agent
SEC_API_KEY=          # sec-api.io full-text search (finance_agent_edgar_search)
SERPAPI_API_KEY=      # Google search via SerpAPI (finance_agent_google_web_search, default backend)
EXA_API_KEY=          # only when an experiment sets web_search: exa
SEC_USER_AGENT=       # "Name email@example.com"; sent only to sec.gov, as SEC requires
