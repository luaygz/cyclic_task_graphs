# Services (loopback defaults match compose.yaml)
LUNA_MONGODB_URI=mongodb://127.0.0.1:27017
LUNA_MONGODB_DB=luna_benchmarks
LUNA_REDIS_URL=redis://127.0.0.1:6379/0
# Optional Compose host-port overrides when the defaults are occupied:
# LUNA_MONGODB_PORT=27018
# LUNA_REDIS_PORT=6380

# Optional live model provider
OPENAI_API_KEY=

# ALFWorld data is downloaded separately with `alfworld-download`.
ALFWORLD_DATA=

# Finance Agent tools
EXA_API_KEY=
SEC_EDGAR_API_KEY=
# Required by SEC.gov for responsible request identification.
# Example: Research Group research-contact@example.org
SEC_USER_AGENT=
